# ==============================================================================
# MedWeb / ArogyaAI Environment Variables Configuration
# ==============================================================================

# Google Gemini Developer API (Server-Side Only)
# Get a free API key at: https://aistudio.google.com/app/apikey
# Keep this secret! Configured in server environment (e.g. Vercel Project Settings or local .env)
# Never prefix with VITE_ to prevent client-side bundle exposure.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase Configuration (Client Environment Variables)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Maps Key
VITE_GOOGLE_MAPS_API_KEY=
